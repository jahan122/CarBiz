{
  "name": "car-deals-manager",
  "productName": "Car Deals Manager",
  "version": "1.0.5",
  "description": "Offline desktop app for tracking car buy & sell deals, expenses and profit.",
  "main": "dist-electron/main.js",
  "author": "Car Deals Manager",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:web": "tsc -p tsconfig.json --noEmit && vite build",
    "build": "npm run build:electron && npm run build:web",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "test:db": "npm run build:electron && node scripts/test-db.cjs",
    "test:db:all": "npm run build:electron && cross-env CARDEALS_DB_DRIVER=better-sqlite3 node scripts/test-db.cjs && cross-env CARDEALS_DB_DRIVER=node-sqlite node scripts/test-db.cjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.3.2",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.cardeals.manager",
    "productName": "Car Deals Manager",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.2.0"
  }
}